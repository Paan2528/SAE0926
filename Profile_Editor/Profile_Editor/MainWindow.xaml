<Window x:Class="Profile_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Profile_Editor"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
       
    <Grid Background="LightPink">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />


        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />

        </Grid.RowDefinitions>
        <TextBox x:Name="NameTextBox" Grid.Column="1" Grid.Row="0" Width="200" Height="30" />
        <TextBlock Grid.Column="0" Grid.Row="0" Height="30" Text="Name:" Margin="210,39,14,18" />
        <TextBlock x:Name="TextResult_Name" Grid.Column="2" Grid.Row="0" TextWrapping="Wrap" Height="30" />

        <TextBox x:Name="EmailTextBox" Grid.Column="1" Grid.Row="1" Width="200" Height="30"  />
        <TextBlock Grid.Column="0" Grid.Row="1" Height="30" Text="E-mail:" Margin="210,39,14,18" />
        <TextBlock  x:Name="TextResult_Email" Grid.Column="2" Grid.Row="1" TextWrapping="Wrap" Height="30" />

        <TextBox x:Name="AddressTextBox" Grid.Column="1" Grid.Row="2" Width="200" Height="30"  />
        <TextBlock Grid.Column="0" Grid.Row="2" Height="30" Text="Address:" Margin="210,39,14,17" />
        <TextBlock x:Name="TextResult_Address" Grid.Column="2" Grid.Row="2" TextWrapping="Wrap" Height="30" />

        <TextBox x:Name="NumberTextBox" Grid.Column="1" Grid.Row="3" Width="200" Height="30"  />
        <TextBlock Grid.Column="0" Grid.Row="3" Height="30" Text="Number:" Margin="193,40,14,17" />
        <TextBlock x:Name="TextResult_Number" Grid.Column="2" Grid.Row="3" TextWrapping="Wrap" Height="30" />

        <TextBlock x:Name="TextResult_successfully" Grid.Column="2" Grid.Row="4" TextWrapping="Wrap" Height="30" Foreground="DarkGreen" />

        <Button x:Name="send_button_Click" Click="Button_Click" Grid.Column="1" Grid.Row="4" Width="200" Height="30" Background="LightBlue" >Send</Button>
    </Grid>


</Window>
